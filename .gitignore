# Repo-wide ignores.  Each module (Lectures/IK/, Examples/, Assignments/A2/) also
# has its own .gitignore for path-specific data and outputs.

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- run outputs: OpenSim / Moco / analysis ----
*.log
*.omoco
results/
_work/

# ---- PDFs and LaTeX build products ----
# Only .tex/.bib sources are tracked; students compile PDFs locally.
# (Script-generated PDF reports are covered here too.)
*.pdf
*.aux
*.bbl
*.bcf
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv

# ---- MATLAB scratch ----
*.asv
*.m~

# ---- editors / IDEs ----
.vscode/
.idea/
*.swp
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini

# ---- local machine settings ----
.claude/settings.local.json
